# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diagnoleads_dev"

# Authentication
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Email (Optional - for production)
RESEND_API_KEY=""

# AI (Optional - for AI features)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Jobs (Optional - for background jobs)
TRIGGER_API_KEY=""
TRIGGER_API_URL="https://api.trigger.dev"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DiagnoLeads"

# CMS (PayloadCMS)
CMS_PROVIDER="mock"  # Options: mock, payload, sanity
PAYLOAD_SECRET="your-payload-secret-here"
PAYLOAD_DATABASE_URL=""  # Optional: Use separate DB for Payload (defaults to DATABASE_URL)

# Email (Resend) - Phase 5.2
# RESEND_API_KEY already defined above
EMAIL_FROM="DiagnoLeads <noreply@diagnoleads.com>"

# Slack Integration - Phase 5.3
# Configure webhook URLs per organization in the dashboard

# Zapier/Make Integration - Phase 5.4
ZAPIER_API_KEY=""  # Optional: For Zapier app authentication
