# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diagnoleads_dev"

# Authentication
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# Email (Optional - for production)
RESEND_API_KEY=""

# AI (Optional - for AI features)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Jobs (Optional - for background jobs)
TRIGGER_API_KEY=""
TRIGGER_API_URL="https://api.trigger.dev"

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DiagnoLeads"

# Public Diagnostic Form (Optional)
# If not set, a "Public Leads" organization will be created automatically
DEFAULT_ORGANIZATION_ID=""

# CMS (PayloadCMS 3.66)
CMS_PROVIDER="payload"  # Options: mock, payload, sanity
PAYLOAD_SECRET="your-payload-secret-here-change-in-production"
# Payload uses the main DATABASE_URL with a separate 'cms' schema

# Email (Resend) - Phase 5.2
# RESEND_API_KEY already defined above
EMAIL_FROM="DiagnoLeads <noreply@diagnoleads.com>"

# Slack Integration - Phase 5.3
# Configure webhook URLs per organization in the dashboard

# Zapier/Make Integration - Phase 5.4
ZAPIER_API_KEY=""  # Optional: For Zapier app authentication

# CMS Webhook Integration
CMS_SLACK_WEBHOOK_URL=""  # Optional: Slack notifications for CMS changes
CMS_ZAPIER_WEBHOOK_URL=""  # Optional: Zapier webhook for CMS events
CMS_ZAPIER_WEBHOOK_SECRET=""  # Optional: Webhook signature secret
CMS_WEBHOOK_URL=""  # Optional: Generic webhook endpoint
CMS_WEBHOOK_SECRET=""  # Optional: Generic webhook secret

# Figma Integration
FIGMA_ACCESS_TOKEN=""  # Optional: For Figma API integration
FIGMA_WEBHOOK_SECRET=""  # Optional: For verifying Figma webhook signatures
FIGMA_AUTO_SYNC="false"  # Optional: Auto-sync content on Figma file updates
